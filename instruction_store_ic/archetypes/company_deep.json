{
  "archetype": "company_deep",
  "name": "公司深度",
  "description": "单/少公司跟踪研究，无产业链分解",
  "is_dynamic": false,
  "waves": [
    {
      "index": 0,
      "name": "投研假说",
      "steps": ["step_executive_hypothesis"],
      "parallel": true
    },
    {
      "index": 1,
      "name": "业务与竞争",
      "steps": ["step_business_overview", "step_competitive_position"],
      "parallel": true
    },
    {
      "index": 2,
      "name": "财务与估值",
      "steps": ["step_financial_deep", "step_valuation_benchmark", "step_moat_analysis"],
      "parallel": true,
      "depends_on_wave": 1
    },
    {
      "index": 3,
      "name": "风险与催化",
      "steps": ["step_risk_assessment", "step_catalyst_analysis"],
      "parallel": true,
      "depends_on_wave": 2
    },
    {
      "index": 4,
      "name": "统稿",
      "steps": ["step_master_synthesis"],
      "parallel": false,
      "depends_on_wave": 3
    }
  ],
  "role_map": {
    "step_executive_hypothesis": "ic_executive_hypothesis",
    "step_business_overview": "ic_business_overview",
    "step_competitive_position": "ic_competitive",
    "step_financial_deep": "ic_supply_chain",
    "step_valuation_benchmark": "ic_competitive",
    "step_moat_analysis": "ic_competitive",
    "step_risk_assessment": "ic_policy_risk",
    "step_catalyst_analysis": "ic_catalyst",
    "step_master_synthesis": "ic_report_synthesizer"
  },
  "step_deps": {
    "step_executive_hypothesis": [],
    "step_business_overview": [],
    "step_competitive_position": [],
    "step_financial_deep": ["step_business_overview"],
    "step_valuation_benchmark": ["step_financial_deep"],
    "step_moat_analysis": ["step_business_overview", "step_competitive_position"],
    "step_risk_assessment": ["step_business_overview", "step_financial_deep"],
    "step_catalyst_analysis": ["step_business_overview", "step_competitive_position"],
    "step_master_synthesis": ["step_risk_assessment", "step_catalyst_analysis", "step_moat_analysis"]
  },
  "connector_map": {
    "ic_executive_hypothesis": ["westock-mcp"],
    "ic_business_overview": ["tyc-mcp", "westock-mcp"],
    "ic_competitive": ["tyc-mcp", "westock-mcp"],
    "ic_supply_chain": ["tyc-mcp", "westock-mcp"],
    "ic_policy_risk": ["tyc-mcp", "westock-mcp"],
    "ic_catalyst": ["tyc-mcp", "westock-mcp"],
    "ic_report_synthesizer": ["tyc-mcp", "westock-mcp"]
  },
  "always_active_steps": ["step_executive_hypothesis", "step_master_synthesis"],
  "step_timeouts": {
    "step_executive_hypothesis": 600,
    "step_financial_deep": 1200,
    "step_master_synthesis": 1200
  },
  "default_timeout": 900
}
