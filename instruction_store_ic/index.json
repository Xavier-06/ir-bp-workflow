  "data_sources": {
    "_comment": "IC 管线全部可用数据源清单。connector 字段标识是否需要 MCP 授权。",
    "westock-mcp": {
      "type": "mcp",
      "connector": true,
      "coverage": "A/HK/美股行情/财务/板块/产业链/研报/评级/资金流/北向持仓",
      "latency": "T+0"
    },
    "tyc-mcp": {
      "type": "mcp",
      "connector": true,
      "coverage": "企业工商/股东/司法/专利/招投标/董监高 160+维度",
      "latency": "T+0"
    },
    "tencent_news": {
      "type": "bash",
      "connector": false,
      "coverage": "突发新闻/实时动态/热点榜（分钟级时效）",
      "latency": "分钟级",
      "call": "sh ~/.workbuddy/skills/skill_2053082907836022784/scripts/run-cli.sh search \"{关键词}\" --limit 5"
    },
    "neodata": {
      "type": "bash",
      "connector": false,
      "coverage": "A/HK股行业数据/深度研报/宏观数据/市场规模",
      "latency": "T+0~T+1",
      "call": "cd ~/.workbuddy/ir_runtime && python3 -c \"from scripts.search_gateway import neodata_search; import json; print(json.dumps(neodata_search('查询语句'), ensure_ascii=False))\""
    },
    "yfinance": {
      "type": "python",
      "connector": false,
      "coverage": "美股估值指标/财务/历史数据",
      "latency": "T+0",
      "call": "cd ~/.workbuddy/ir_runtime && python3 -c \"import yfinance as yf; t=yf.Ticker('AAPL'); print(t.info)\""
    },
    "web_search": {
      "type": "builtin",
      "connector": false,
      "available": false,
      "coverage": "本环境不可用，用 search_deep(Bash) 替代",
      "latency": "实时"
    },
    "web_fetch": {
      "type": "builtin",
      "connector": false,
      "available": false,
      "coverage": "本环境不可用，用 search_deep(Bash, fetch_top_n) 替代",
