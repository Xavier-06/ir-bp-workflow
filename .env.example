# ═══ IR/BP Workflow 环境变量配置 ═══
# 复制此文件为 .env 并填写你的配置: cp .env.example .env
#
# 配置说明：
#   ✅ 必需 — 缺少会导致对应管线无法运行
#   ⚡ 推荐 — 显著提升搜索质量和数据丰富度
#   🔧 按需 — 根据你的网络环境和工作流选择
#   💡 可选 — 高级功能，大多数用户不需要

# ══════════════════════════════════════════════
# ✅ VL OCR API（BP 管线必需）
# ══════════════════════════════════════════════
# BP 管线使用视觉模型对 PDF/PPTX 文档进行 OCR 识别和结构化抽取。
# 支持任何兼容 OpenAI API 格式的视觉模型服务（如阿里云百炼、硅基流动等）。
#
VL_API_BASE=https://your-vl-api-provider/v1   # ← 替换为你的 VL API 地址
VL_API_KEY=sk-xxxx                            # ← 替换为你的 API Key
VL_MODEL=qwen3-vl-30b-a3b-instruct            # 默认模型，可按服务商调整

# ══════════════════════════════════════════════
# ⚡ 搜索网关配置（强烈推荐）
# ══════════════════════════════════════════════

# SearXNG 本地搜索实例（提升搜索质量，自动聚合多引擎结果）
# 安装: docker run -d -p 8888:8888 --name searxng searxng/searxng:latest
# SEARXNG_URL=http://127.0.0.1:8888

# DuckDuckGo CLI 二进制名（默认 ddgs，免密钥，搜索网关最终降级层）
# 安装: pip install duckduckgo-search
# DDGS_BIN=ddgs

# ══════════════════════════════════════════════
# 🔧 网络配置
# ══════════════════════════════════════════════

# HTTP 代理 — 用于 Google/Scrapling 等需要翻墙的搜索层
# 不设置则搜索网关自动跳过需要代理的层，降级到 SearXNG/DDG
# PROXY_URL=http://127.0.0.1:7897

# SSL 证书路径（macOS 用户如遇 SSL 错误时设置）
# macOS Homebrew: /opt/homebrew/etc/openssl@3/cert.pem
# SSL_CERT_PATH=/opt/homebrew/etc/openssl@3/cert.pem

# ══════════════════════════════════════════════
# 🔧 SearXNG 密钥（仅自建实例需要）
# ══════════════════════════════════════════════
# 如果你自建了 SearXNG 并设置了 secret，在这里填写对应的值
# SEARXNG_SECRET=your-searxng-secret

# ══════════════════════════════════════════════
# ⚡ WorkBuddy MCP 服务（BP 管线必需）
# ══════════════════════════════════════════════
# 以下 MCP 不需要在这里配置，请在 WorkBuddy 的 Connector 设置中连接：
#
#   qcc-company  — 工商信息（股东、注册资本、法人、变更、分支机构、对外投资）
#   qcc-risk     — 风险信息（诉讼、失信被执行人、行政处罚、经营异常）
#   qcc-ipr      — 知识产权（专利、商标、著作权）
#   qcc-operation— 经营信息（招投标、资质许可、年报）
#
# BP 管线 Phase 0.5 工商验证和维度分析大量依赖企查查 MCP。
# IR 管线通过搜索网关获取工商数据，不依赖 MCP。

# ══════════════════════════════════════════════
# 💡 通知插件配置（可选）
# ══════════════════════════════════════════════
# 如果你需要管线完成后的消息推送，可以配置以下任一：
# WECHAT_BOT_KEY=YOUR_WECHAT_BOT_KEY
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ══════════════════════════════════════════════
# 💡 向量记忆（可选，用于 ChromaDB 语义搜索）
# ══════════════════════════════════════════════
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
