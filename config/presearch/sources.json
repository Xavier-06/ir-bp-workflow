      "freshness": "T+0"
    },
    "westock_finance": {
      "label": "腾讯自选股-财务数据",
      "description": "营收/利润/ROE/毛利率等结构化财务指标",
      "source": "westock-mcp",
      "tool": "data_finance",
      "suitable_for": ["财务分析", "行业基准", "公司财务"],
