{
  "version": "1.0",
  "sources": {
    "web_search": {
      "label": "Web 通用搜索",
      "description": "通过 search_gateway 进行网页搜索，覆盖 SearXNG/DDG/Yahoo",
      "module": "scripts.search_gateway",
      "function": "search",
      "params": {
        "max_results": 8,
        "timeout": 20
      },
      "suitable_for": ["通用信息", "行业研究", "公司信息", "技术文献", "政策法规"],
      "freshness": "T+0~小时级"
    },
    "tencent_news": {
      "label": "腾讯新闻",
      "description": "7×24 实时新闻搜索，分钟级时效，适合突发消息和最新动态",
      "module": "scripts.presearch_adapters.tencent_news_adapter",
      "function": "search_news",
      "params": {
        "max_results": 10
      },
      "suitable_for": ["突发新闻", "最新动态", "政策发布", "公司公告", "行业事件"],
      "freshness": "分钟级",
      "priority": "highest_for_news"
    },
    "westock_sector": {
      "label": "腾讯自选股-行业板块",
